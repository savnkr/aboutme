---
// Section heading drawn as an "observation": a small posterior band that
// tightens when the section scrolls into view (see .obs-band in global.css).
const { n, title, link, linkLabel, note } = Astro.props;
---
<div class="section-head">
  <h2 class="section-title">
    <span class="obs" aria-hidden="true">
      <svg viewBox="0 0 40 16"><path class="obs-band" d="M0 8 C10 1, 30 1, 40 8 C30 15, 10 15, 0 8Z" /><path class="obs-mean" d="M0 8 C12 5, 28 11, 40 8" /><circle cx="20" cy="8" r="2.4" /></svg>
      obs. {String(n).padStart(2, '0')}
    </span>
    {title}
  </h2>
  {note && <span class="meta">{note}</span>}
  {link && <a href={link}>{linkLabel ?? 'More'} →</a>}
</div>
