---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { asset, href } from '../../lib/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const src = (path?: string) => (path && path.startsWith('/') ? asset(path) : path);
---

<Base title="Projects · Sawan Kumar" description="Generative models, robotics and uncertainty: projects with demos and code.">
  <article class="page">
    <h1>Projects</h1>
    <p class="deck">Generative models you can act on, built where the stakes are real: weather risk, robots that see and ask, and engineering design. Each one is fast, and honest about what it doesn’t know. Details appear here as each project produces results.</p>
    <div class="cards project-cards">
      {projects.map((project) => (
        <a class:list={['card', { teaser: project.data.teaser }]} href={project.data.teaser ? undefined : href(`/projects/${project.id}/`)}>
          {project.data.cover ? <img class="cover" src={src(project.data.cover)} alt="" loading="lazy" /> : project.data.figure && <div class="art" data-sphere={project.data.figure === 'sphere' ? '' : undefined}><canvas data-figure={project.data.figure} aria-hidden="true"></canvas></div>}
          <p class="meta">{project.data.teaser ? <span class="badge">In the lab · 2026–27</span> : <>{project.data.status} · {project.data.year}</>}</p>
          <h2>{project.data.title}</h2>
          <p>{project.data.teaser ? project.data.summary : (project.data.impact ?? project.data.summary)}</p>
          <p class="tags">{project.data.tags.map((tag) => <span>{tag}</span>)}</p>
        </a>
      ))}
    </div>
  </article>
</Base>
