---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { href } from '../../lib/site';

const posts = (await getCollection('thoughts')).sort((a, b) => Number(a.data.draft) - Number(b.data.draft) || b.data.date.valueOf() - a.data.date.valueOf());
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<Base title="Thoughts · Sawan Kumar" description="Notes on making, reading, and ordinary life.">
  <article class="page thoughts">
    <h1>Thoughts</h1>
    <p class="deck">Beliefs and moments, kept off the technical shelf. <a href={href('/thoughts/rss.xml')}>RSS</a></p>
    <div data-filter-root class="filters">
      <button type="button" data-tag="all" class="on">All</button>
      {tags.map((tag) => <button type="button" data-tag={tag}>{tag}</button>)}
    </div>
    <div class="rows">
      {posts.map((post) => <PostCard post={post} section="thoughts" />)}
    </div>
  </article>
</Base>
